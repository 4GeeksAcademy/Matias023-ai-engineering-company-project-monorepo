# ──────────────────────────────────────────────
# TrackFlow Supplier Directory API
# ──────────────────────────────────────────────

# Authentication
SECRET_KEY=replace-with-a-secure-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Password reset
RESET_TOKEN_EXPIRE_MINUTES=30

# Resend (email delivery)
RESEND_API_KEY=replace-with-your-resend-api-key
RESEND_FROM=onboarding@resend.dev

# Frontend URL (used in password reset email links)
FRONTEND_URL=http://localhost:5173

# ──────────────────────────────────────────────
# Inventory: relational database (ORM / dual DB)
# ──────────────────────────────────────────────
# SKU / StockEntry / StockExit live in PostgreSQL/Supabase, configured via
# DATABASE_URL. TinyDB keeps handling users/profiles/suppliers/incidents.
# DATABASE_URL is read at engine-build time, so a value in this .env file is
# honoured after load_dotenv() runs.
#
# Production safety: with APP_ENV=production and no DATABASE_URL, startup
# FAILS instead of silently falling back to an in-memory SQLite database.
# Leave APP_ENV unset (or set to development) for local SQLite dev/test.
#
# Example (Supabase/Postgres):
# DATABASE_URL=postgresql://user:password@host:5432/postgres
# APP_ENV=development
# ALLOW_SQLITE_FALLBACK=1   # only needed if you must run prod-mode on SQLite
DATABASE_URL=
