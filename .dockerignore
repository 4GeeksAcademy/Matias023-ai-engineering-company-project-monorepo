# The API imports the reporting pipeline from these repository-root packages.
# Keep other data assets out of the image while allowing just their Python code.
!data/
data/*
!data/__init__.py
!data/pipelines/
data/pipelines/*
!data/pipelines/*.py
services/api/data/
services/api/.venv/
uis/website/node_modules/
uis/backoffice/node_modules/
uis/backoffice/dist/
uis/website/dist/
README*
CONTEXT*
docs/
# Excluir scripts generales; permitir motor RAG
scripts/*
!scripts/rag/
scripts/rag/*
!scripts/rag/*.py
skills/
workflows/
